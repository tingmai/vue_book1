views/CategoryIndex.vue

<template>
  <div class="container p-4">

   
         <router-link to="/create" class="btn btn-primary my-4"> <i class="fa fa-arrow-circle-right"></i> Create New Category </router-link>
    
     <div class="row">
    <table class="table table-striped">
      <tr>
        <td> ID </td> 
        <td> Name </td> 
        <td> Action </td>
      </tr>

      <tr v-for="cat in categories" :key="cat.id">
         <td> {{ cat.id }} </td><td> {{ cat.name }}</td>
          <td>
        <router-link class="btn btn-outline-primary " :to="`/edit/${cat.id}`"> <i class="fa fa-pencil"></i> Edit </router-link> &nbsp;&nbsp;
        <button class="btn btn-outline-danger" @click="deleteCat(cat.id)"> <i class="fa fa-trash"></i> Delete </button>
        </td>
      </tr>
    </table>
    </div>

  </div>
</template>

<script>
import axios from 'axios';

export default {
  data() {
    return {
      categories: [],
    };
  },
   async mounted(){
        const response = await axios.get('http://localhost:3000/categories');
        this.categories = response.data;
         
    },

  methods:{
    
    async deleteCat(catId) {
      const confirm = window.confirm('Are you sure you want to delete this posts?');
      try{
        if(confirm) {
            const response = await axios.delete(`http://localhost:3000/categories/${catId}`);
            this.categories = this.categories.filter(x => x.id !== catId);
            this.$router.push('/')
        }

        }
        catch(err){
             console.log('Error Deleting...',err)
        }
     }

  }
 
};
</script>


