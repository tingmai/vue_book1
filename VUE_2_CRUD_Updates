<template>
  <div class="container my-4">
    <div class="row">
    <h2>Create Category </h2>
    </div>
    <div class="row">
      <div class="col-lg-6">  </div>
      <div class="col-lg-4">
    <form @submit.prevent="createCat">
      <label> Category Id </label>
      <input v-model="id" placeholder="ID" class="form-control my-4" />
      <label> Category Name</label>
      <input v-model="name" placeholder="Name " class="form-control my-4" />
      <button type="submit" class="btn btn-outline-primary" > Create </button>
    </form>
      </div>
      </div>
  </div>
</template>

<script>
import axios from 'axios';

export default {
  data() {
    return {
      id: 0,
      name: '',
    };
  },
  methods: {
    async createCat() {
      const response = await axios.post('http://localhost:3000/categories', {
        id: this.id,
        name: this.name,
      });
      this.$router.push('/');
    },
  },
};
</script>


