<template>
  <div class="container my-4">
     
         <router-link to="/" class="btn btn-primary my-4"> <i class="fa fa-arrow-right-circle"></i> Back </router-link>
  
     <div class="row">
     <div class="col-lg-6"> <i class="fa fa-list" style="font-size:100px"></i> </div>
     <div class="col-lg-4">
    <form @submit.prevent="updateCategory">
      <input v-model="category.id" class="form-control my-4" />
      <input v-model="category.name" class="form-control my-4"/>
      <button type="submit" class="btn btn-primary" ><i class="fa fa-refresh"></i> Update</button>
    </form>
     </div>
    </div>
  </div>
</template>

<script>
import axios from 'axios';

export default {
  props: ['id'],
  data() {
    return {
      category: {
        id: 0,
        name: '',
      },
    };
  },

  mounted(){
     this.getCategory()
  },
  
  methods: {

    async getCategory() {
    const response = await axios.get(`http://localhost:3000/categories/${this.id}`);
    this.category = response.data;
  },
    async updateCategory() {
      await axios.put(`http://localhost:3000/categories/${this.id}`, this.category);
      this.$router.push('/');
    },
  },
};
</script>










